# Kopieren als .env und ausfüllen
SECRET_KEY=ein-langer-zufaelliger-string-hier

# Mail (z.B. Gmail App-Passwort oder eigener SMTP)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=deine@gmail.com
MAIL_PASSWORD=dein-app-passwort
MAIL_DEFAULT_SENDER=deine@gmail.com
ADMIN_EMAIL=deine@gmail.com

# Domain (.org läuft über deinen bestehenden Cloudflare Tunnel, .de wird später umgeleitet)
SITE_URL=https://stumpfmeista3d.org

# Matomo Analytics (nach erstem Setup ausfüllen)
MATOMO_URL=https://matomo.stumpfmeista3d.org
MATOMO_SITE_ID=1
MATOMO_DB_PASSWORD=sicheres-passwort-fuer-matomo-db
MATOMO_DB_ROOT_PASSWORD=sicheres-root-passwort-fuer-mariadb
